# ═══════════════════════════════════════════════════════════
#  Koda LLM 配置（OpenAI 兼容协议）
#  复制为 .env 并填入你自己的 API 信息即可。
#
#  规则：填了 LLM_API_KEY → 自动使用真实模型
#        留空          → 自动回退 mock 模式（无需 key 也能体验完整流程）
# ═══════════════════════════════════════════════════════════

# 【必填】API 密钥
LLM_API_KEY=

# 【必填】模型名称，例如 gpt-4o-mini / deepseek-chat / qwen-plus
LLM_MODEL=

# 【选填】API 地址；官方 OpenAI 可留空。
# 用第三方网关/中转/自建服务时填它，需带 /v1 后缀，例如：
#   https://api.deepseek.com/v1
#   https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=

# 供应商标识（目前仅 openai 兼容协议）
LLM_PROVIDER=openai


# ── 别名说明 ────────────────────────────────────────────────
# 以下写法等价，按顺序取第一个非空值，方便从别的项目直接复制 .env：
#   模型   : LLM_MODEL    → OPENAI_MODEL     → MODEL_NAME
#   密钥   : LLM_API_KEY  → OPENAI_API_KEY   → API_KEY
#   地址   : LLM_BASE_URL → LLM_API_BASE     → OPENAI_BASE_URL → OPENAI_API_BASE
#
# 注意：Open WebUI 界面相关配置不在这里，而在 config/webui.env。
