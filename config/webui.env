# Open WebUI × Koda 集成环境配置（全部落在项目文件夹内）
# 被 scripts/start_webui.sh 自动加载；可直接修改本文件调整行为。
#
# 设计原则：**零本地模型下载**。所有模型能力一律走 API，
#            不拉取任何 HuggingFace / sentence-transformers / whisper 权重。

# ---- 端口 ----
KODA_PORT=8321
WEBUI_PORT=3000

# ---- Koda 后端 ----
# 1 = 无需 API key 的 mock 模式（体验用）
# 0 = 走 .env 里的真实模型（需填好 LLM_API_KEY / LLM_API_BASE / LLM_MODEL）
# auto = 自动判断：.env 里有 key 就用真实模型，没有就回退 mock（推荐）
KODA_OPENAI_MOCK=auto

# ---- Open WebUI 基础 ----
# 界面默认语言：简体中文
DEFAULT_LOCALE=zh-CN
# 关闭 Ollama 探测，避免启动变慢
ENABLE_OLLAMA_API=false
# 模型来源指向 Koda（OPENAI_API_BASE_URL 由启动脚本按 KODA_PORT 自动拼接）
OPENAI_API_KEY=koda-local

# 本地会话密钥（仅本机使用；如需对外暴露请换成长随机串）
WEBUI_SECRET_KEY=koda-local-secret-change-me

# 预置管理员（首次启动、空数据库时自动创建）
WEBUI_ADMIN_EMAIL=admin@koda.local
WEBUI_ADMIN_PASSWORD=koda-local-1
WEBUI_ADMIN_NAME=admin

# 关闭遥测 / 版本检查，纯本地运行更快
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false


# ══════════════════════════════════════════════════════════
#  零下载策略：以下配置确保启动时不下载任何模型权重
# ══════════════════════════════════════════════════════════

# 【总闸】离线模式：内部强制 HF_HUB_OFFLINE=1 并关闭版本检查。
# 这是硬兜底 —— 即使某处漏配，也无法联网拉取 HuggingFace 权重。
OFFLINE_MODE=true

# 【嵌入模型】默认为空字符串 = 本地 sentence-transformers（会下载 ~90MB）。
# 设为 openai 后改走 API，启动时完全不加载本地模型。
RAG_EMBEDDING_ENGINE=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small

# 嵌入用的 API 地址与 key。
# 留空时会继承 OPENAI_API_BASE_URL（指向 Koda，而 Koda 不提供 embeddings 端点）。
# 如需使用「文档知识库 / RAG」功能，请在这里填你自己的 embedding API：
#   RAG_OPENAI_API_BASE_URL=https://api.openai.com/v1
#   RAG_OPENAI_API_KEY=sk-xxxxxxxx
# 不填也不影响普通聊天。
#RAG_OPENAI_API_BASE_URL=
#RAG_OPENAI_API_KEY=

# 【重排模型】留空 = 不加载、不下载
RAG_RERANKING_MODEL=

# 【语音识别】默认为空 = 本地 faster-whisper（会下载权重）。
# 设为 openai 走 API；如需使用请补 AUDIO_STT_OPENAI_API_KEY。
AUDIO_STT_ENGINE=openai
AUDIO_TTS_ENGINE=openai

# 【自动更新】即使将来切回本地引擎，也不允许联网自动拉取
RAG_EMBEDDING_MODEL_AUTO_UPDATE=false
RAG_RERANKING_MODEL_AUTO_UPDATE=false

# 【HF 兜底】禁止 huggingface_hub 发起任何网络请求
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
